   "access.read_rule": "canReadLabour() in lib/auth/roles.ts: the labour authority's officials; auditors with a purpose; every read in the access log",
   "access.others": "Other institutions learn only an employer's standing through employer.standing"
  },
  "nation_values": [],
  "deviations": [
   {
    "id": "minimisation",
    "what": "The seven minimisation answers per field (Part 1 §1.6) are not in the library contract: they are given with the procedure package the nation approves and recorded in the data and privacy review (a human publication gate)",
    "why": "Question 2 (the provision that authorises collection) is the nation's law; a library draft cannot answer it. No form is approved without the review.",
    "rule": "CLAUDE.md forms: publication is lib/forms/publication.ts (human approvals by different signed-in officials)"
   },
   {
    "id": "evidence-requirement",
    "what": "Each evidence item names its kind and when it is needed; the civicos.evidence-requirement.v1 record that ties it to a provision of law is made with the nation's procedure package",
    "why": "The legal basis of evidence is the nation's; until it is cited the evidence gate does not pass.",
    "rule": "Field series Part 1 §1.4; lib/forms/publication.ts gate \"evidence\""
   },
   {
    "id": "scanning",
    "what": "Scanning, OCR, USSD/SMS and offline field capture are not on the platform: a paper form is transcribed by an official and the case records that it came on paper and who transcribed it",
    "why": "Not built (integration register 20.6, 20.7).",
    "rule": "CLAUDE.md Integration register"
   },
   {
    "id": "no-score",
    "what": "No field scores a person, a household, a credential, an employer or an application: no risk, credibility, propensity or match score exists in the contract or its procedure",
    "why": "Directions §15.6 and §15.7; supplement Part 15: a risk score alone cannot determine loss of essential support; field series Part 4 §4.4: no opaque risk scores.",
    "rule": "CLAUDE.md Immigration and Customs (\"never a score\"); lib/social/procedures.ts refuses a suspension whose grounds rest on a score"
   },
   {
    "id": "authority-slot",
    "what": "The labour authority is the institution the nation names for the labour slot, shipped empty; until it is named no case opens",
    "why": "Specification Part 2 §A.6: the government assigns these functions.",
    "rule": "lib/nation/deployment.ts AUTHORITIES (labour, optional)"
   },
   {
    "id": "signed-by-session",
    "what": "The inspector's or signatory's signature is the signed-in official's act on the case step (verified session; four-eyes where the procedure asks), sealed with the decision, not a signature field",
    "why": "Who acted is the verified official, never a name or image in the form.",
    "rule": "CLAUDE.md Who acted: withOfficial(); lib/records/decisions.ts seals the decision"
   }
  ],
