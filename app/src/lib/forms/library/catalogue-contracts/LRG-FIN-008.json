 "library": {
  "title": "Submit a local budget",
  "intro": "Submit the local budget: revenue, expenditure and capital lines in whole minor units. It is adopted by two officials on the council's certified resolution; a submission to another institution carries a reference only.",
  "owner": "institution",
  "filled_by": "The local government's finance officials.",
  "authority": "Each local government's own: filed with the local government (an institution of standing subnational) that adopted the procedure; never the whole government's.",
  "procedure": {
   "key": "lg.budget",
   "stage": "draft",
   "action": "submit",
   "document": "budget-document"
  },
  "lists": {},
  "nation_values": [],
  "deviations": [
   {
    "id": "minimisation",
    "what": "The seven minimisation answers per field (Part 1 §1.6) are not in the library contract: they are given with the procedure package the nation approves and recorded in the data and privacy review (a human publication gate)",
    "why": "Question 2 (the provision that authorises collection) is the nation's law; a library draft cannot answer it. No form is approved without the review.",
    "rule": "CLAUDE.md forms: publication is lib/forms/publication.ts (human approvals by different signed-in officials)"
   },
   {
    "id": "evidence-requirement",
    "what": "Each evidence item names its kind and when it is needed; the civicos.evidence-requirement.v1 record that ties it to a provision of law is made with the nation's procedure package",
    "why": "The legal basis of evidence is the nation's; until it is cited the evidence gate does not pass.",
    "rule": "Field series Part 1 §1.4; lib/forms/publication.ts gate \"evidence\""
   },
   {
    "id": "scanning",
    "what": "Scanning, OCR, USSD/SMS and offline field capture are not on the platform: a paper form is transcribed by an official and the case records that it came on paper and who transcribed it",
    "why": "Not built (integration register 20.6, 20.7).",
    "rule": "CLAUDE.md Integration register"
   },
   {
    "id": "institution-owned",
    "what": "The owner is each local government itself (an institution of standing subnational): it adopts the procedure as its own (lg.<template>.<institution>), drafted by one of its officials and approved by another",
    "why": "Local and regional authorities have their own institutional scope, records and delegated powers; the whole government reaches them only under an approved relationship.",
    "rule": "lib/localgov/procedures.ts installLocalGovernmentProcedures(); lib/auth/roles.ts Boundaries.subnational"
   },
   {
    "id": "two-officials",
    "what": "Every registration and decision is proposed by one official and confirmed by a different person; the official who verified or reviewed does not decide",
    "why": "Catalogue Part 8 §3.3 and Part 9 §5: dual control by distinct authorised individuals.",
    "rule": "lib/casework/engine.ts act() (fourEyes, distinctFrom); lib/data/dual-control.ts dualControlRefusal()"
   },
   {
    "id": "no-ai-decision",
    "what": "No step is decided by a model, a score or a map: officials decide with reasons",
    "why": "AI never makes a legally material decision.",
    "rule": "CLAUDE.md Government operating model (AI never makes a legally material decision)"
   },
   {
    "id": "whole-minor-units",
    "what": "Budget amounts are whole numbers in the nation's minor units, entered by officials line by line; totals are computed, never typed",
    "why": "No figure ships; the budget register of the finance ministry is not on the platform (plan I5).",
    "rule": "lib/localgov/procedures.ts lg.check-budget"
   }
  ],
