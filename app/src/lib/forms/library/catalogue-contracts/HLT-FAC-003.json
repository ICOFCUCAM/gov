  "deviations": [
   {
    "id": "inspector-from-sign-in",
    "field": "inspector_id",
    "what": "The inspector is recorded from the sign-in (officer field), never typed",
    "why": "Stricter: findings are entered under the inspector's own account.",
    "rule": "CLAUDE.md Who acted: a signed-in official's verified name replaces any name in the request"
   },
   {
    "id": "no-score",
    "what": "A finding has a result and an observation, never a score",
    "why": "Platform rule: no risk score anywhere; a finding is a prompt, never a conclusion.",
    "rule": "CLAUDE.md Customs/Audit administration (never a score; a finding is a prompt)"
   },
   {
    "id": "no-patient-data",
    "what": "Patient consent, emergency clinical access and a shared patient reference do not arise: the form carries no patient, clinical, treatment, diagnosis or individual health field",
    "why": "Allowed scope only: health facility and professional regulation and aggregate statistics.",
    "rule": "CLAUDE.md Health: no patient or clinical field anywhere, no national patient record; owner's direction 2026-10-21 §1"
   },
   {
    "id": "minimisation",
    "what": "The seven minimisation answers per field (Part 1 §1.6) are not in the library contract: they are given with the procedure package the nation approves and recorded in the data and privacy review (a human publication gate)",
    "why": "Question 2 (the provision that authorises collection) is the nation's law; a library draft cannot answer it. No form is approved without the review.",
    "rule": "CLAUDE.md forms: publication is lib/forms/publication.ts (human approvals by different signed-in officials)"
   },
   {
    "id": "evidence-requirement",
    "what": "Each evidence item names its kind and when it is needed; the civicos.evidence-requirement.v1 record that ties it to a provision of law is made with the nation's procedure package",
    "why": "The legal basis of evidence is the nation's; until it is cited the evidence gate does not pass.",
    "rule": "Field series Part 1 §1.4; lib/forms/publication.ts gate \"evidence\""
   },
   {
    "id": "scanning",
    "what": "Scanning, OCR, USSD/SMS and offline field capture are not on the platform: a paper form is transcribed by an official and the case records that it came on paper and who transcribed it",
    "why": "Not built (integration register 20.6, 20.7).",
    "rule": "CLAUDE.md Integration register"
   }
  ],
