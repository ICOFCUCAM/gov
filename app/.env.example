# CivicOS — substrate environment template.
# Copy to .env.local and fill in.

NEXT_PUBLIC_SUPABASE_URL=https://gtgpbokcbngchvoijish.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_1JJI0CAPkS1ax6_uBndoAg_dHAJxalC

# Optional — required only for server-side seeding / RLS-bypass admin scripts.
# SUPABASE_SERVICE_ROLE_KEY=

# ── Sign-in and key custody (keep every key outside the platform state) ──
# With CIVICOS_AUTH=enforce, CIVICOS_SESSION_SECRET is required (at least 32
# random characters): without it no session is issued or accepted, and sign-in
# answers 503 saying so. Only outside enforce mode is a key generated into the
# state (previews, first installation).
# CIVICOS_AUTH=enforce
# CIVICOS_SESSION_SECRET=
# The first administrator needs a one-time setup code (go-live review C-1):
# set it here (24+ characters, the same on every replica; optional end time),
# or leave it unset and copy the code the server writes to its output at start
# ("CIVICOS SETUP CODE", valid 24 hours). Remove it once the account exists.
# CIVICOS_SETUP_TOKEN=
# CIVICOS_SETUP_TOKEN_EXPIRES=2026-12-31T00:00:00Z
# With the substrate connected, officials sign in there and no platform account
# is created, unless allowed as a break-glass fallback:
# CIVICOS_LOCAL_ACCOUNTS=allow
# Machine secrets, one per purpose, sent only as Authorization: Bearer (review M-7):
# CIVICOS_CRON_SECRET=           (/api/cron/* only: pg_cron, Vercel Cron)
# CIVICOS_EXPORT_SECRET=         (/api/substrate/export and /digest)
# CIVICOS_PUBLISHER_SECRET=      (/api/releases/publisher/* automation, e.g. CI)
# CIVICOS_PROVISIONING_SECRET=   (/api/admin/officers/bulk, /api/federation/webhooks/test)
# Deprecated: lets the cron secret still open a purpose without its own secret (logged each use).
# CIVICOS_LEGACY_SHARED_SECRET=1
# Ed25519 key (PKCS#8 PEM, or the path of a key file) that signs audit chain heads.
# CIVICOS_AUDIT_KEY=
# Append-only file the audit-anchor job writes signed heads to (file mode default:
# .civicos-anchors/platform-audit-heads.jsonl beside the state directory).
# CIVICOS_AUDIT_ANCHOR_FILE=
# 32-byte key (base64 or hex) that seals authenticator secrets with AES-256-GCM;
# CIVICOS_DATA_KEK_PREVIOUS opens values during a rotation.
# CIVICOS_DATA_KEK=
# CIVICOS_DATA_KEK_PREVIOUS=
# Ed25519 key (PKCS#8 PEM, or the path of a key file) that signs exchange receipts.
# CIVICOS_EXCHANGE_KEY=
# Ed25519 key (PKCS#8 PEM, or a key file) that signs integrations' OAuth2 access
# tokens (POST /api/oauth/token). Without it a key is made per process, so
# tokens do not cross instances or restarts.
# CIVICOS_TOKEN_KEY=
# The public origin senders sign @target-uri against, when behind a proxy.
# CIVICOS_PUBLIC_ORIGIN=https://gov.example
# Where the audit, exchange, token and data keys are held (lib/keys/custody.ts):
# env (default: the variables above), vault (HashiCorp Vault / OpenBao Transit)
# or kms-http (a cloud KMS or HSM behind the generic shim). With vault or
# kms-http no private key or key encryption key enters the platform.
# CIVICOS_KEY_PROVIDER=vault
# CIVICOS_VAULT_ADDR=https://vault.gov.example:8200
# CIVICOS_VAULT_TOKEN=            (or _FILE, as written by a Vault agent)
# CIVICOS_VAULT_ROLE_ID=          (AppRole; with CIVICOS_VAULT_SECRET_ID, each also as _FILE)
# CIVICOS_VAULT_SECRET_ID=
# CIVICOS_VAULT_NAMESPACE=
# CIVICOS_VAULT_TRANSIT_MOUNT=transit
# CIVICOS_VAULT_CA=/etc/civicos/vault-ca.pem
# CIVICOS_VAULT_AUDIT_KEY=civicos-audit        (ed25519)
# CIVICOS_VAULT_EXCHANGE_KEY=civicos-exchange  (ed25519)
# CIVICOS_VAULT_TOKEN_KEY=civicos-token        (ed25519; or CIVICOS_KMS_TOKEN_KEY)
# CIVICOS_VAULT_DATA_KEY=civicos-data          (aes256-gcm96)
# CIVICOS_KMS_URL=https://kms-shim.gov.example/
# CIVICOS_KMS_TOKEN=
# CIVICOS_KMS_CA=
# RFC 3161 time-stamps for signed audit heads from the nation's own TSA (off unless set).
# CIVICOS_TSA_URL=https://tsa.gov.example/tsr
# CIVICOS_TSA_CA=/etc/civicos/tsa-ca.pem      (the TSA certificate must chain to it)
# CIVICOS_TSA_AUTH=Basic …                    (when the TSA asks for credentials)
# CIVICOS_TSA_TLS_CA=                          (CA file for the TSA's web certificate)
# CIVICOS_TSA_POLICY=                          (a policy OID to request)
# Outbound fetches (twin sources, downloads, webhooks) through the nation's egress proxy:
# a CONNECT tunnel to the address that was checked (lib/net/pinned-fetch.ts).
# CIVICOS_EGRESS_PROXY=http://proxy.gov.example:3128
# CIVICOS_EGRESS_NO_PROXY=.gov.example
# Mutual TLS between installations (lib/exchange/mtls.ts, federation-client.ts).
# This installation's client certificate when calling partners:
# CIVICOS_FEDERATION_CERT=/etc/civicos/federation/tls.crt
# CIVICOS_FEDERATION_KEY=/etc/civicos/federation/tls.key
# CIVICOS_FEDERATION_CA=/etc/civicos/federation/ca.crt
# Accept partners' client certificates verified by the ingress (ssl-client-* headers),
# only on the federation host:
# CIVICOS_TRUST_PROXY_CLIENT_CERT=1
# CIVICOS_FEDERATION_HOST=federation.gov.example
# ── Traces (off unless set): the nation's own OpenTelemetry collector, OTLP/HTTP ──
# CIVICOS_OTEL_ENDPOINT=http://otel-collector:4318
# CIVICOS_OTEL_HEADERS=authorization=Bearer%20…
# CIVICOS_OTEL_SAMPLE_RATIO=1
# ── AI assistant (only when the nation opted in during setup) ──
# Key for the model service chosen in setup (ANTHROPIC_API_KEY also works for the default service).
# CIVICOS_AI_API_KEY=
# AI advisories each official may request a minute (default 10).
# CIVICOS_AI_RPM=10
