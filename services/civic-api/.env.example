# CivicOS API — environment. Copy to .env for local dev.
# Production secrets come from the sovereign secret manager (Vault/KMS),
# never committed.

PORT=4000

# Postgres (primary). Production points at the sovereign cluster.
DATABASE_URL=postgresql://civic:civic@localhost:5432/civicos?schema=public

# Message bus (optional at boot; outbox backlog drains when reachable).
NATS_URL=nats://localhost:4222
OUTBOX_POLL_MS=2000

# CORS allowlist (comma-separated origins). Empty disables cross-origin.
CIVIC_CORS_ORIGINS=http://localhost:3000

# Dev auth: accept x-civic-principal header (base64url JSON). NEVER in prod.
CIVIC_DEV_AUTH=1
